# ============================================================
# Valora Tour — Environment Variables
# Copy file ini menjadi .env.local lalu isi nilainya.
# Untuk deploy Vercel: Project Settings > Environment Variables,
# isi nilai yang sama (tanpa kutip).
# ============================================================

# Password login /admin (buat yang kuat, min 12 karakter)
ADMIN_PASSWORD=

# Dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Gunakan "service_role" secret key — HANYA server-side, JANGAN NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs (tanpa trailing slash) untuk link di pesan WhatsApp
NEXT_PUBLIC_SITE_URL=
